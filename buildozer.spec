[app]
title = CheeTaH Sniper
package.name = cheetahsniper
package.domain = org.cheetah
source.dir = .
source.include_exts = py,png,jpg,kv,atlas
version = 0.1
requirements = python3,kivy,websockets,certifi,urllib3,idna,charset-normalizer,requests
orientation = portrait
fullscreen = 0
